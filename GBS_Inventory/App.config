<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <configSections>
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>

  <!-- ════════════════════════════════════════════════════════════════════
       Connection String Oracle
       Ajuste conforme sua instalação local:
         * Data Source  = TNS alias ou host:port/serviceName
         * User ID      = usuário do schema (ex: gbs_user)
         * Password     = senha do schema
       Exemplo para Oracle XE local:
         Data Source=localhost:1521/XE;User ID=gbs_owner;Password=gbs_pass
  ═════════════════════════════════════════════════════════════════════ -->
  <connectionStrings>
    <add name="OracleDB"
         connectionString="User Id=gbs_owner;Password=gbs_pass;Data Source=localhost:1521/XE;"
         providerName="Oracle.ManagedDataAccess.Client"/>
  </connectionStrings>

  <appSettings>
    <!-- ID da empresa padrão no multi-tenant -->
    <add key="IdEmpresa" value="1"/>

    <!-- Versão do sistema -->
    <add key="Versao" value="1.0.0"/>

    <!-- Caminho padrão para importação de planilhas -->
    <add key="CaminhoPlanilhas" value="C:\GBS\Planilhas"/>
    <!-- Invoice -->
    <add key="InvoiceOutputPath" value="C:\GBS\Invoices"/>
    <add key="InvoiceLogoPath" value=""/>
    <add key="UiVariantClientesInvoice" value="B"/>

    <!-- SMTP (preencher conforme ambiente) -->
	<add key="InvoiceLogoPath" value="C:\GBS\logo.png"/>  
	<add key="SmtpHost"     value="smtp.mail.yahoo.com"/>
	<add key="SmtpPort"      value="587"/>
	<add key="SmtpEnableSsl" value="true"/>
	<add key="SmtpUser"     value="hernani_jorge@yahoo.com.br"/>
	<add key="SmtpPassword"  value="byhatfieopimhgvb"/>
	<add key="SmtpFrom"     value="hernani_jorge@yahoo.com.br"/>
  </appSettings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Oracle.ManagedDataAccess"
                          publicKeyToken="89b483f429c47342"
                          culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.122.21.1"
                         newVersion="4.122.21.1"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
