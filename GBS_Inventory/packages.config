<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!--
    Oracle.ManagedDataAccess — driver Oracle 100% .NET (não requer Oracle Client instalado)
    Após restaurar os pacotes, a referência Oracle.ManagedDataAccess nos arquivos .vb
    continuará válida pois o namespace é o mesmo.
  -->
  <package id="Oracle.ManagedDataAccess" version="21.13.0" targetFramework="net48" />
  <package id="BouncyCastle" version="1.8.9" targetFramework="net48" />
  <package id="iTextSharp" version="5.5.13.3" targetFramework="net48" />
  <package id="EPPlus" version="4.5.3.3" targetFramework="net48" />
</packages>
